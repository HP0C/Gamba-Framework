{
  "name": "gambaserver",
  "private": true,
  "version": "0.1.0",
  "workspaces": ["apps/*"],
  "overrides": {
    "multer": "^2.2.0"
  },
  "scripts": {
    "build": "npm run build -w @gamba/backend && npm run build -w @gamba/frontend",
    "test": "npm run test -w @gamba/backend",
    "lint": "npm run lint -w @gamba/backend && npm run lint -w @gamba/frontend",
    "prisma:generate": "npm run prisma:generate -w @gamba/backend",
    "prisma:migrate": "npm run prisma:migrate -w @gamba/backend",
    "prisma:studio": "npm run prisma:studio -w @gamba/backend"
  },
  "engines": { "node": ">=20" }
}
