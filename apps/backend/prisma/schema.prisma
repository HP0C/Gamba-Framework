generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum VerificationStatus {
  NOT_STARTED
  PENDING
  VERIFIED
  REJECTED
}

enum AccountProvider {
  LOCAL
  GOOGLE
}

enum WalletTransactionType {
  INITIAL_CREDIT
  BET_STAKE
  BET_PAYOUT
  ADJUSTMENT
  DEPOSIT
  WITHDRAWAL
}

enum BankingProvider {
  TRUE_LAYER
}

enum BankingConnectionStatus {
  AUTHORIZATION_REQUIRED
  ACTIVE
  REVOKED
  ERROR
}

enum BankingPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
}

enum ExternalTransactionDirection {
  INBOUND
  OUTBOUND
}

enum BetStatus {
  PENDING
  SETTLED
  VOID
}

enum GameType {
  COIN_FLIP
  ROULETTE
}

model User {
  id                     String             @id @default(uuid()) @db.Uuid
  email                  String             @unique
  username               String             @unique
  passwordHash           String?
  googleId               String?            @unique
  status                 UserStatus         @default(ACTIVE)
  ageVerificationStatus  VerificationStatus @default(NOT_STARTED)
  kycStatus              VerificationStatus @default(NOT_STARTED)
  gamblingExcludedUntil  DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  accounts               Account[]
  sessions               Session[]
  wallets                Wallet[]
  bets                   Bet[]
  gameRounds             GameRound[]
  auditLogs               AuditLog[]
  bankConnections        BankConnection[]
  bankingPayments        BankingPayment[]
  bankingPayouts         BankingPayout[]
}

model Account {
  id                String          @id @default(uuid()) @db.Uuid
  userId            String          @db.Uuid
  provider          AccountProvider
  providerAccountId String
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  user              User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id               String    @id @default(uuid()) @db.Uuid
  userId           String    @db.Uuid
  refreshTokenHash String
  userAgent        String?
  ipAddress        String?
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime  @default(now())
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model Wallet {
  id           String              @id @default(uuid()) @db.Uuid
  userId       String              @db.Uuid
  balance      BigInt              @default(0)
  currency     String              @default("GBP") @db.VarChar(3)
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  user         User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  transactions WalletTransaction[]
  bankingPayments BankingPayment[]
  bankingPayouts  BankingPayout[]

  @@unique([userId, currency])
}

model WalletTransaction {
  id            String                @id @default(uuid()) @db.Uuid
  walletId      String                @db.Uuid
  type          WalletTransactionType
  amount        BigInt
  balanceBefore BigInt
  balanceAfter  BigInt
  referenceType String
  referenceId   String
  idempotencyKey String?              @unique
  createdAt     DateTime              @default(now())
  wallet        Wallet                @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model BankConnection {
  id                   String                  @id @default(uuid()) @db.Uuid
  userId               String                  @db.Uuid
  provider             BankingProvider
  providerConnectionId String
  status               BankingConnectionStatus @default(ACTIVE)
  consentExpiresAt     DateTime?
  metadata             Json?
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  user                 User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  accounts             ExternalBankAccount[]

  @@unique([provider, providerConnectionId])
  @@index([userId])
}

model ExternalBankAccount {
  id                String                    @id @default(uuid()) @db.Uuid
  connectionId      String                    @db.Uuid
  providerAccountId String
  displayName       String
  accountType       String
  currency          String                    @default("GBP") @db.VarChar(3)
  currentBalance    BigInt                    @default(0)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt
  connection        BankConnection            @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  transactions      ExternalBankTransaction[]

  @@unique([connectionId, providerAccountId])
  @@index([connectionId])
}

model ExternalBankTransaction {
  id                    String                       @id @default(uuid()) @db.Uuid
  bankAccountId         String                       @db.Uuid
  providerTransactionId String
  amount                BigInt
  currency              String                       @default("GBP") @db.VarChar(3)
  direction             ExternalTransactionDirection
  description           String
  merchantName          String?
  category              String?
  transactionAt         DateTime
  raw                   Json?
  createdAt             DateTime                     @default(now())
  updatedAt             DateTime                     @updatedAt
  bankAccount           ExternalBankAccount          @relation(fields: [bankAccountId], references: [id], onDelete: Cascade)
  usedForPayments       BankingPayment[]

  @@unique([bankAccountId, providerTransactionId])
  @@index([bankAccountId, transactionAt])
}

model BankingPayment {
  id                  String                   @id @default(uuid()) @db.Uuid
  userId              String                   @db.Uuid
  walletId            String                   @db.Uuid
  sourceTransactionId String?                  @db.Uuid
  provider            BankingProvider
  providerPaymentId   String
  paymentSourceId     String?
  amount              BigInt
  currency            String                   @default("GBP") @db.VarChar(3)
  status              BankingPaymentStatus     @default(PENDING)
  idempotencyKey      String                   @unique
  raw                 Json?
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt
  settledAt           DateTime?
  user                User                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet              Wallet                   @relation(fields: [walletId], references: [id], onDelete: Restrict)
  sourceTransaction   ExternalBankTransaction? @relation(fields: [sourceTransactionId], references: [id], onDelete: SetNull)

  @@unique([provider, providerPaymentId])
  @@index([userId, createdAt])
}

model BankingPayout {
  id                String               @id @default(uuid()) @db.Uuid
  userId            String               @db.Uuid
  walletId          String               @db.Uuid
  provider          BankingProvider
  providerPayoutId  String
  amount            BigInt
  currency          String               @default("GBP") @db.VarChar(3)
  status            BankingPaymentStatus @default(PENDING)
  idempotencyKey    String               @unique
  raw               Json?
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  settledAt         DateTime?
  user              User                 @relation(fields: [userId], references: [id], onDelete: Restrict)
  wallet            Wallet               @relation(fields: [walletId], references: [id], onDelete: Restrict)

  @@unique([provider, providerPayoutId])
  @@index([userId, createdAt])
}

model Bet {
  id             String     @id @default(uuid()) @db.Uuid
  userId         String     @db.Uuid
  gameRoundId    String     @unique @db.Uuid
  gameType       GameType
  stake          BigInt
  selection      String
  result         String?
  payout         BigInt     @default(0)
  status         BetStatus  @default(PENDING)
  rngNonce       BigInt
  serverSeedHash String
  clientSeed     String?
  createdAt      DateTime   @default(now())
  settledAt      DateTime?
  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict)
  gameRound      GameRound  @relation(fields: [gameRoundId], references: [id], onDelete: Restrict)

  @@index([userId, createdAt])
}

model GameRound {
  id             String    @id @default(uuid()) @db.Uuid
  userId         String    @db.Uuid
  gameType       GameType
  serverSeedHash String
  serverSeed     String
  clientSeed     String?
  nonce          BigInt
  publicResult   String?
  createdAt      DateTime  @default(now())
  settledAt      DateTime?
  user           User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  bet            Bet?

  @@unique([userId, gameType, nonce])
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String?  @db.Uuid
  action     String
  entityType String
  entityId   String?
  metadata   Json?
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([entityType, entityId])
}
