DATABASE_URL=postgresql://gamba:gamba@localhost:5432/gamba?schema=public
DIRECT_URL=postgresql://gamba:gamba@localhost:5432/gamba?schema=public
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-character-secret
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback
FRONTEND_URL=http://localhost:5173
# Custom URL schemes accepted for authenticated mobile banking returns.
# Keep this list narrow in production. exp/exps are only for Expo Go testing.
MOBILE_APP_ALLOWED_SCHEMES=gamba,exp,exps
PORT=3000
NODE_ENV=development
DEFAULT_WALLET_BALANCE=0
TRUELAYER_MODE=sandbox
TRUELAYER_CLIENT_ID=
TRUELAYER_CLIENT_SECRET=
TRUELAYER_REDIRECT_URI=http://localhost:3000/api/banking/truelayer/callback
TRUELAYER_MERCHANT_ACCOUNT_ID=
TRUELAYER_CERTIFICATE_ID=
TRUELAYER_PRIVATE_KEY=
TRUELAYER_AUTH_URL=https://auth.truelayer-sandbox.com/connect/token
TRUELAYER_API_BASE_URL=https://api.truelayer-sandbox.com
TRUELAYER_DATA_PROVIDER_ID=uk-cs-mock
TRUELAYER_PAYMENT_PROVIDER_ID=mock-payments-gb-redirect
TRUELAYER_PAYMENT_RETURN_URI=http://localhost:3000/api/banking/truelayer/payment-callback
TRUELAYER_PAYMENT_HPP_BASE_URL=https://app.truelayer-sandbox.com/payments
TRUELAYER_CREDIT_DEPOSITS_ON=executed
